{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCGW Desktop",
  "version": "0.1.0",
  "identifier": "com.haonguyen.ccgw-rust-desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "CCGW Desktop",
        "width": 1240,
        "height": 860,
        "minWidth": 860,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
